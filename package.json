{
  "name": "@huddle/monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Multiplayer control for local coding agents",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run && pnpm --filter @huddle/web test",
    "test:e2e": "node ./scripts/e2e-local.mjs",
    "test:gate": "node ./scripts/phase-gate-scorecard.mjs",
    "test:codex-smoke": "node ./scripts/codex-smoke.mjs",
    "build:web": "pnpm --filter @huddle/web build",
    "huddle": "huddle",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@huddle/cli": "workspace:*",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "fast-check": "^4.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8",
    "ws": "^8.21.1",
    "zod": "^3.24.2"
  }
}
