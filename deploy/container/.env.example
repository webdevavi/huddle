# Copy to .env and replace secrets before any real deployment.
# Telemetry defaults off for self-host.

HUDDLE_HOST=0.0.0.0
HUDDLE_PORT=8080
HUDDLE_BASE_URL=http://localhost:8080

# Database: SQLite path for small self-host; switch to Postgres for production.
# SQLite volume must be durable and backed up; concurrent writers are limited.
HUDDLE_DATABASE_URL=sqlite:///data/huddle.db
# HUDDLE_DATABASE_URL=postgres://huddle:huddle@db:5432/huddle

HUDDLE_DATA_DIR=/data

# GitHub OAuth application (required for real auth; stub skips verification)
HUDDLE_GITHUB_CLIENT_ID=
HUDDLE_GITHUB_CLIENT_SECRET=

# Signing / session secrets (generate strong random values)
HUDDLE_SESSION_SECRET=replace-me
HUDDLE_SIGNING_SECRET=replace-me

# Self-host telemetry defaults off
HUDDLE_TELEMETRY=off

# Retention (hours) for invite material and ephemeral session data
HUDDLE_INVITE_TTL_HOURS=24
